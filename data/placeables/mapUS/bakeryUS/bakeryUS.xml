<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_shopItem_bakery</name>
        <functions>
            <function>$l10n_function_productionPoint</function>
        </functions>
        <image>$data/store/store_empty.png</image>
        <price>50000</price>
        <showInStore>false</showInStore>
        <canBeSold>true</canBeSold>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
        <vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>0</indexBufferMemoryUsage>
        <textureMemoryUsage>0</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>$data/placeables/mapUS/bakeryUS/bakeryUS.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <canBeDeleted>false</canBeDeleted>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
            <testArea startNode="testAreaStart02" endNode="testAreaEnd02" />
        </testAreas>
        <sounds>
            <place template="smallImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
        <clearArea startNode="clearAreaStart02" widthNode="clearAreaWidth02" heightNode="clearAreaHeight02"/>
        <clearArea startNode="clearAreaStart03" widthNode="clearAreaWidth03" heightNode="clearAreaHeight03"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="asphalt"/>
            <levelArea startNode="levelAreaStart02" widthNode="levelAreaWidth02" heightNode="levelAreaHeight02" groundType="asphalt"/>
            <levelArea startNode="levelAreaStart03" widthNode="levelAreaWidth03" heightNode="levelAreaHeight03" groundType="asphalt"/>
        </levelAreas>
        <paintAreas>
            <paintArea startNode="paintAreaStart01" widthNode="paintAreaWidth01" heightNode="paintAreaHeight01" groundType="asphalt"/>
            <paintArea startNode="paintAreaStart02" widthNode="paintAreaWidth02" heightNode="paintAreaHeight02" groundType="asphalt"/>
            <paintArea startNode="paintAreaStart03" widthNode="paintAreaWidth03" heightNode="paintAreaHeight03" groundType="asphalt"/>
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
        <indoorArea startNode="indoorAreaStart02" widthNode="indoorAreaWidth02" heightNode="indoorAreaHeight02" />
        <indoorArea startNode="indoorAreaStart03" widthNode="indoorAreaWidth03" heightNode="indoorAreaHeight03" />
        <indoorArea startNode="indoorAreaStart04" widthNode="indoorAreaWidth04" heightNode="indoorAreaHeight04" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="playerTriggerMarker" />
    </hotspots>

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart filename="$data/placeables/mapUS/bakeryUS/bakeryUSProps.i3d" node="0" linkNode="props" />
    </dynamicallyLoadedParts>

    <triggerMarkers>
        <triggerMarker node="warningStripes01"/>
        <triggerMarker node="warningStripes02"/>
        <triggerMarker node="playerTriggerMarker" filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
        <triggerMarker node="unloadTriggerMarker" filename="$data/shared/assets/marker/markerIconUnload.i3d" adjustToGround="true"/>
    </triggerMarkers>

    <lights>
        <group weatherRequiredFlags="NIGHT" />

        <lightShape node="interior" groupIndex="1"/>

        <realLights>
            <low>
                <light node="realLights" groupIndex="1"/>
            </low>
            <high>
                <light node="realLights" groupIndex="1"/>
            </high>
        </realLights>
    </lights>

    <productionPoint>
        <productions sharedThroughputCapacity="false">
            <production id="bread" name="%s (%s)" params="$l10n_fillType_bread|$l10n_fillType_flour" cyclesPerHour="5" costsPerActiveHour="2.5">
                <inputs>
                    <input fillType="FLOUR" amount="360" />
                </inputs>
                <outputs>
                    <output fillType="BREAD" amount="180" />
                </outputs>
            </production>
            <production id="breadRiceFlour" name="%s (%s)" params="$l10n_fillType_bread|$l10n_fillType_riceFlour" cyclesPerHour="2" costsPerActiveHour="3">
                <inputs>
                    <input fillType="RICEFLOUR" amount="68" />
                </inputs>
                <outputs>
                    <output fillType="BREAD" amount="45" />
                </outputs>
            </production>

            <production id="cake" name="%s (%s)" params="$l10n_fillType_cake|$l10n_fillType_flour" cyclesPerHour="2" costsPerActiveHour="2.5">
                <inputs>
                    <input fillType="FLOUR"        amount="8" />
                    <input fillType="SUGAR"        amount="8" />
                    <input fillType="MILK_BOTTLED" amount="8" />
                    <input fillType="EGG"          amount="8" />
                    <input fillType="BUTTER"       amount="8" />
                    <input fillType="STRAWBERRY"   amount="8" />
                </inputs>
                <outputs>
                    <output fillType="CAKE" amount="21" />
                </outputs>
            </production>
            <production id="cakeRiceFlour" name="%s (%s)" params="$l10n_fillType_cake|$l10n_fillType_riceFlour" cyclesPerHour="2" costsPerActiveHour="2.5">
                <inputs>
                    <input fillType="RICEFLOUR"    amount="6" />
                    <input fillType="SUGAR"        amount="8" />
                    <input fillType="MILK_BOTTLED" amount="8" />
                    <input fillType="EGG"          amount="8" />
                    <input fillType="BUTTER"       amount="8" />
                    <input fillType="STRAWBERRY"   amount="8" />
                </inputs>
                <outputs>
                    <output fillType="CAKE" amount="21" />
                </outputs>
            </production>
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="FLOUR"        capacity="110000" />
            <capacity fillType="RICEFLOUR"    capacity="82000" />
            <capacity fillType="SUGAR"        capacity="5000" />
            <capacity fillType="MILK_BOTTLED" capacity="5000" />
            <capacity fillType="EGG"          capacity="5000" />
            <capacity fillType="BUTTER"       capacity="5000" />
            <capacity fillType="STRAWBERRY"   capacity="5000" />
            <capacity fillType="BREAD"        capacity="55000" />
            <capacity fillType="CAKE"         capacity="10000" />
        </storage>

        <sellingStation node="sellingStation" appearsOnStats="true" supportsExtension="false">
            <unloadTrigger exactFillRootNode="exactFillRootNode" aiNode="unloadTriggerAINode" fillTypes="MILK_BOTTLED" />
            <palletTrigger triggerNode="palletTrigger" aiNode="unloadTriggerAINode" fillTypes="FLOUR RICEFLOUR SUGAR MILK_BOTTLED EGG BUTTER STRAWBERRY" />
        </sellingStation>

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01"/>
                <spawnPlace startNode="palletAreaStart02" endNode="palletAreaEnd02"/>
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger" />
        <sounds>
            <idle   template="bakeryIdle" linkNode="0>" outerRadius="50"/>
            <active template="bakeryWork" linkNode="0>" outerRadius="50"/>
        </sounds>
    </productionPoint>

    <i3dMappings>
        <i3dMapping id="bakeryUS" node="0>" />
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="clearAreaStart02" node="0>0|1" />
        <i3dMapping id="clearAreaWidth02" node="0>0|1|0" />
        <i3dMapping id="clearAreaHeight02" node="0>0|1|1" />
        <i3dMapping id="clearAreaStart03" node="0>0|2" />
        <i3dMapping id="clearAreaWidth03" node="0>0|2|0" />
        <i3dMapping id="clearAreaHeight03" node="0>0|2|1" />
        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="levelAreaStart02" node="0>1|1" />
        <i3dMapping id="levelAreaWidth02" node="0>1|1|0" />
        <i3dMapping id="levelAreaHeight02" node="0>1|1|1" />
        <i3dMapping id="levelAreaStart03" node="0>1|2" />
        <i3dMapping id="levelAreaWidth03" node="0>1|2|0" />
        <i3dMapping id="levelAreaHeight03" node="0>1|2|1" />
        <i3dMapping id="paintAreaStart01" node="0>2|0" />
        <i3dMapping id="paintAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="paintAreaHeight01" node="0>2|0|1" />
        <i3dMapping id="paintAreaStart02" node="0>2|1" />
        <i3dMapping id="paintAreaWidth02" node="0>2|1|0" />
        <i3dMapping id="paintAreaHeight02" node="0>2|1|1" />
        <i3dMapping id="paintAreaStart03" node="0>2|2" />
        <i3dMapping id="paintAreaWidth03" node="0>2|2|0" />
        <i3dMapping id="paintAreaHeight03" node="0>2|2|1" />
        <i3dMapping id="indoorAreaStart01" node="0>3|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>3|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>3|0|1" />
        <i3dMapping id="indoorAreaStart02" node="0>3|1" />
        <i3dMapping id="indoorAreaWidth02" node="0>3|1|0" />
        <i3dMapping id="indoorAreaHeight02" node="0>3|1|1" />
        <i3dMapping id="indoorAreaStart03" node="0>3|2" />
        <i3dMapping id="indoorAreaWidth03" node="0>3|2|0" />
        <i3dMapping id="indoorAreaHeight03" node="0>3|2|1" />
        <i3dMapping id="indoorAreaStart04" node="0>3|3" />
        <i3dMapping id="indoorAreaWidth04" node="0>3|3|0" />
        <i3dMapping id="indoorAreaHeight04" node="0>3|3|1" />
        <i3dMapping id="testAreaStart01" node="0>4|0" />
        <i3dMapping id="testAreaEnd01" node="0>4|0|0" />
        <i3dMapping id="testAreaStart02" node="0>4|1" />
        <i3dMapping id="testAreaEnd02" node="0>4|1|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>5|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>5|0|0" />
        <i3dMapping id="realLights" node="0>6|0" />
        <i3dMapping id="interior" node="0>6|1" />
        <i3dMapping id="infoTrigger" node="0>7" />
        <i3dMapping id="sellingStation" node="0>8" />
        <i3dMapping id="exactFillRootNode" node="0>8|0" />
        <i3dMapping id="palletTrigger" node="0>8|1" />
        <i3dMapping id="unloadTriggerMarker" node="0>8|2" />
        <i3dMapping id="unloadTriggerAINode" node="0>8|3" />
        <i3dMapping id="warningStripes01" node="0>8|4" />
        <i3dMapping id="playerTrigger" node="0>9|0" />
        <i3dMapping id="playerTriggerMarker" node="0>9|1" />
        <i3dMapping id="palletSpawner" node="0>10" />
        <i3dMapping id="palletAreaStart01" node="0>10|0" />
        <i3dMapping id="palletAreaEnd01" node="0>10|0|0" />
        <i3dMapping id="palletAreaStart02" node="0>10|1" />
        <i3dMapping id="palletAreaEnd02" node="0>10|1|0" />
        <i3dMapping id="warningStripes02" node="0>10|2" />
        <i3dMapping id="props" node="0>11|0" />
        <i3dMapping id="curtains" node="0>12|0|0|5|2" />
    </i3dMappings>
</placeable>
